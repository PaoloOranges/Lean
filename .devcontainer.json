{
  "name": "Lean SDK 10 (image-only, no build)",
  "image": "mcr.microsoft.com/dotnet/sdk:10.0",
  "workspaceMount": "source=${localWorkspaceFolder},target=/Lean,type=bind",
  "workspaceFolder": "/Lean",
  "mounts": [
    "source=${localWorkspaceFolder}/../lean-storage,target=/lean-storage,type=bind"
  ],
  "containerEnv": {
    "LEAN_CONFIG": "/Lean/config.devcontainer.json",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOG": "1"
  },
  "updateContentCommand": "python3 tools/fetch_etheur_hourly.py || echo 'updateContent: ETHEUR hourly fetch skipped (source API unavailable)'",
  "postCreateCommand": "bash /Lean/.devcontainer/post-create.sh",
  "runArgs": [
    "--network=host",
    "--shm-size=1g"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "eamodio.gitlens"
      ]
    }
  }
}
