{
  "name": "Lean SDK 10 (image-only, no build)",
  "image": "mcr.microsoft.com/dotnet/sdk:10.0",
  "workspaceMount": "source=${localWorkspaceFolder},target=/Lean,type=bind",
  "workspaceFolder": "/Lean",
  "mounts": [
    "source=/opt/data/docker-shared,target=/data,type=bind,ro",
    "source=/opt/data/workspace/lean-storage,target=/lean-storage,type=bind"
  ],
  "containerEnv": {
    "QUANTCONNECT_API_USERNAME": "${localEnv:QUANTCONNECT_API_USERNAME}",
    "QUANTCONNECT_API_TOKEN": "${localEnv:QUANTCONNECT_API_TOKEN}",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOG": "1"
  },
  "updateContentCommand": "bash /Lean/docker/data-mount-check.sh",
  "postCreateCommand": "bash /Lean/.devcontainer/post-create.sh",
  "runArgs": [
    "--network=host",
    "--shm-size=1g"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-python.python",
        "eamodio.gitlens"
      ]
    }
  }
}
